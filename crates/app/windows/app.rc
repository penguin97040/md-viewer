// Resources for md-viewer.exe.
#define RT_MANIFEST 24
// build.rs defines MDV_NO_MANIFEST for MSVC, where GPUI's own manifest is linked and a second
// one is a link error.
#ifndef MDV_NO_MANIFEST
1 RT_MANIFEST "app.manifest"
#endif
// Icon id 1 is the one Explorer shows for the file.
1 ICON "../../../assets/icon.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x4
FILETYPE 0x1
{
  BLOCK "StringFileInfo"
  {
    BLOCK "040904B0"
    {
      VALUE "CompanyName", "penguin97040"
      VALUE "FileDescription", "MD Viewer"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "md-viewer"
      VALUE "LegalCopyright", "MIT licence"
      VALUE "OriginalFilename", "md-viewer.exe"
      VALUE "ProductName", "MD Viewer"
      VALUE "ProductVersion", "1.0.0"
      VALUE "Comments", "A small, fast markdown viewer"
    }
  }
  BLOCK "VarFileInfo"
  {
    VALUE "Translation", 0x409, 0x4B0
  }
}
