{
  "$description": "Netherbase design tokens (W3C Design Tokens format). Generate platform code from this file; never hand-copy values. Sizes are in px at 1x (1rem = 16px; use pt on iOS and dp/sp on Android).",
  "color": {
    "$type": "color",
    "black": { "$value": "#000000", "$description": "Page and screen background, always" },
    "line": { "$value": "#2c2c2c", "$description": "1px dividers only" },
    "muted": { "$value": "#8f8f8f", "$description": "Labels and secondary text (6.5:1 on black)" },
    "text": { "$value": "#f2f2f2", "$description": "Primary text (18.8:1 on black)" },
    "beak": { "$value": "#db7700", "$description": "The single accent, <= 5% of any view (6.7:1 on black). Use black text on beak fills" },
    "illustration": {
      "charcoal": { "$value": "#222222", "$description": "Penguin artwork only, never UI" },
      "slate": { "$value": "#333333", "$description": "Penguin artwork only, never UI" },
      "umber": { "$value": "#8b4723", "$description": "Penguin artwork and the hero-barcode glitch layer only, never text" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "barcode": { "$value": ["Libre Barcode 39 Text"], "$description": "brand/fonts/LibreBarcode39Text-Regular.ttf. Hero barcodes only, wrapped in *...*" },
      "display": { "$value": ["Chakra Petch"], "$description": "brand/fonts/ChakraPetch-Regular.ttf (weight 400) for h1, ChakraPetch-SemiBold.ttf (weight 600) for other headings" },
      "body": { "$value": ["Chakra Petch"], "$description": "brand/fonts/ChakraPetch-Regular.ttf (weight 400). Long-form text" },
      "mono": { "$value": ["Share Tech Mono"], "$description": "brand/fonts/ShareTechMono-Regular.ttf. Labels and UI, upper case" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "semibold": { "$value": 600 }
    }
  },
  "typography": {
    "$type": "typography",
    "heroBarcode": { "$value": { "fontFamily": "{font.family.barcode}", "fontWeight": 400, "fontSize": { "value": 64, "unit": "px" }, "lineHeight": 1, "letterSpacing": { "value": 0, "unit": "px" } }, "$description": "Scale so the bars match the wordmark width (web: calc(100cqi / 6.69) for *NOT FOR SALE*); each glyph advances 0.48em, bars are 0.48n - 0.03em wide. Colour: beak" },
    "h1": { "$value": { "fontFamily": "{font.family.display}", "fontWeight": 400, "fontSize": { "value": 34, "unit": "px" }, "lineHeight": 1.12, "letterSpacing": { "value": -0.34, "unit": "px" } }, "$description": "Web range 25.6-41.6px. Sentence case, centred. Colour: text" },
    "h2": { "$value": { "fontFamily": "{font.family.display}", "fontWeight": 600, "fontSize": { "value": 24, "unit": "px" }, "lineHeight": 1.2, "letterSpacing": { "value": 0, "unit": "px" } }, "$description": "Web range 20.8-28px. Sentence case" },
    "body": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": 400, "fontSize": { "value": 17, "unit": "px" }, "lineHeight": 1.6, "letterSpacing": { "value": 0, "unit": "px" } }, "$description": "Web range 16-18px. Colour: text or muted" },
    "label": { "$value": { "fontFamily": "{font.family.mono}", "fontWeight": 400, "fontSize": { "value": 11.2, "unit": "px" }, "lineHeight": 1.4, "letterSpacing": { "value": 2, "unit": "px" } }, "$description": "0.7rem with 0.18em tracking. UPPER CASE. Colour: muted" },
    "button": { "$value": { "fontFamily": "{font.family.mono}", "fontWeight": 400, "fontSize": { "value": 12.8, "unit": "px" }, "lineHeight": 1, "letterSpacing": { "value": 2, "unit": "px" } }, "$description": "0.8rem with 0.16em tracking. UPPER CASE" }
  },
  "size": {
    "$type": "dimension",
    "contentMaxWidth": { "$value": { "value": 640, "unit": "px" }, "$description": "Single column, 40rem" },
    "gutter": { "$value": { "value": 20, "unit": "px" }, "$description": "Minimum side space on phones" },
    "lineWidth": { "$value": { "value": 1, "unit": "px" } },
    "cornerRadius": { "$value": { "value": 0, "unit": "px" }, "$description": "Square corners everywhere" },
    "touchTargetIOS": { "$value": { "value": 44, "unit": "px" }, "$description": "44x44 pt minimum" },
    "touchTargetAndroid": { "$value": { "value": 48, "unit": "px" }, "$description": "48x48 dp minimum" },
    "nzMark": { "$value": { "value": 22, "unit": "px" }, "$description": "Southern Cross height (width 17.6px, viewBox 24x30), beside 'Aotearoa New Zealand'" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } },
    "12": { "$value": { "value": 48, "unit": "px" } },
    "16": { "$value": { "value": 64, "unit": "px" } }
  },
  "effect": {
    "heroGlow": { "$type": "shadow", "$value": { "color": "#db770059", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 0, "unit": "px" }, "blur": { "value": 24, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }, "$description": "text-shadow on the hero barcode ONLY (beak at 0.35 alpha). No other glows or shadows anywhere" }
  },
  "motion": {
    "entrance": {
      "duration": { "$type": "duration", "$value": { "value": 700, "unit": "ms" } },
      "easing": { "$type": "cubicBezier", "$value": [0, 0, 0.58, 1], "$description": "ease-out" },
      "stagger": { "$type": "duration", "$value": { "value": 120, "unit": "ms" }, "$description": "logo 0, headline 120, barcode 240" },
      "offsetY": { "$type": "dimension", "$value": { "value": 8, "unit": "px" }, "$description": "Fade up from 8px below, opacity 0 to 1, once" }
    },
    "glitch": {
      "cycle": { "$type": "duration", "$value": { "value": 6000, "unit": "ms" }, "$description": "Hero barcode only, a subtle failing neon sign: brownout opacity stutter at 18%, one thin tear at 52%, burst at 86-92% (power sag plus thin bands sliding a few px). No skew. Idle ~90%" }
    },
    "reduceMotion": { "$description": "When the OS asks for reduced motion, disable the entrance and glitch. The static glow stays" }
  }
}
